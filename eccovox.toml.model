[server]
host = "127.0.0.1"
port = 8870

[runtime]
temp_dir = ".eccovox/tmp"
model_cache_dir = ".eccovox/models"
state_dir = ".eccovox/state"
log_dir = ".eccovox/logs"
request_timeout_seconds = 120
profiles = ["default", "balanced", "premium", "diagnostic", "process"]
default_profile = "balanced"

[stt]
enabled = true
engine = "faster-whisper"
profile = "balanced"
model = "medium"
device = "cuda"
compute_type = "int8_float16"
max_audio_bytes = 10485760
short_audio_budget_millis = 5000
max_concurrent = 1
queue_size = 0

[tts]
enabled = true
engine = "kokoro"
profile = "balanced"
voice = "pf_dora"
language = "pt-BR"
response_format = "wav"
max_text_chars = 4000
short_text_start_budget_millis = 2000
max_concurrent = 1
queue_size = 0
